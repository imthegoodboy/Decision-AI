# Decision AI — environment configuration
# Copy to .env.local and fill in. Every value below is read through
# src/server/config/env.ts and validated at startup; nothing is hard-coded.

# ─── OpenAI (required) ──────────────────────────────────────────────
OPENAI_API_KEY=
# Optional: point at a compatible gateway or proxy.
OPENAI_BASE_URL=
# Reasoning / synthesis model: planning, scoring, recommendation, analyst chat.
OPENAI_MODEL=gpt-5.5
# High-volume model: claim extraction, verification, source assessment.
OPENAI_FAST_MODEL=gpt-5.4-mini
# Semantic passage retrieval. Leave empty to use lexical (BM25) retrieval only.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# minimal | low | medium | high — sent only to models that accept it.
OPENAI_REASONING_EFFORT=low

# ─── Web research ──────────────────────────────────────────────────
# auto picks the first configured provider: tavily → brave → serper → openai.
# "openai" uses the Responses API web_search tool (no extra key needed).
SEARCH_PROVIDER=auto
TAVILY_API_KEY=
BRAVE_API_KEY=
SERPER_API_KEY=
# Upper bounds for a single research run.
RESEARCH_MAX_SOURCES=16
RESEARCH_MAX_QUERIES=8
RESEARCH_FETCH_TIMEOUT_MS=12000
RESEARCH_CONCURRENCY=4

# ─── Storage ───────────────────────────────────────────────────────
# Local file (default) or a remote libSQL/Turso URL (libsql://...).
DATABASE_URL=file:./data/decision-ai.db
DATABASE_AUTH_TOKEN=
